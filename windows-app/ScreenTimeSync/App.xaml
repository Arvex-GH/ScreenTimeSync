<Application x:Class="ScreenTimeSync.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:ScreenTimeSync.Helpers"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters (referenced as StaticResource in views) -->
            <helpers:BoolToColorConverter x:Key="BoolToColor"/>
            <helpers:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <helpers:InitialConverter x:Key="InitialConverter"/>
            <helpers:PercentToWidthConverter x:Key="PercentToWidth"/>

            <!-- Design System -->
            <SolidColorBrush x:Key="BgBrush" Color="#0B0E14"/>
            <SolidColorBrush x:Key="CardBrush" Color="#151A26"/>
            <SolidColorBrush x:Key="CardBorderBrush" Color="#232A3D"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#6C5CE7"/>
            <SolidColorBrush x:Key="Accent2Brush" Color="#00CEC9"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8F9FF"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9AA0B8"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="#00B894"/>
            <SolidColorBrush x:Key="WarningBrush" Color="#FDCB6E"/>
            <SolidColorBrush x:Key="DangerBrush" Color="#E17055"/>

            <Style TargetType="TextBlock" x:Key="H1">
                <Setter Property="FontSize" Value="32"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="FontFamily" Value="Segoe UI Variable"/>
            </Style>
            <Style TargetType="TextBlock" x:Key="H2">
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Style>
            <Style TargetType="TextBlock" x:Key="Caption">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="Opacity" Value="0.9"/>
            </Style>

            <DropShadowEffect x:Key="CardShadow" BlurRadius="20" ShadowDepth="4" Opacity="0.25" Color="#000000"/>
            
            <Style x:Key="GlassCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Padding" Value="20"/>
                <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            </Style>

            <Style x:Key="PillBadge" TargetType="Border">
                <Setter Property="CornerRadius" Value="999"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="Background" Value="#1E2438"/>
                <Setter Property="BorderBrush" Value="#2A3350"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
